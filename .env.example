# Copy to .env (never commit .env). Local development values only.
SCHOOMANO_DB_OWNER_USER=schoomano_owner
SCHOOMANO_DB_OWNER_PASSWORD=change-me-owner
SCHOOMANO_DB_APP_USER=schoomano_app
SCHOOMANO_DB_APP_PASSWORD=change-me-app
SCHOOMANO_DB_PORT=5432
SCHOOMANO_DB_URL=jdbc:postgresql://localhost:5432/schoomano

# Local only: accept "Bearer dev:<subject>" for seeded synthetic users. Refused under the prod profile.
SCHOOMANO_AUTH_DEV_MODE=true
SCHOOMANO_CORS_ORIGINS=http://localhost:5173

# Production uses OIDC instead of dev tokens:
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://login.example.invalid/realms/schoomano

# Web app
VITE_API_BASE_URL=http://localhost:8080
