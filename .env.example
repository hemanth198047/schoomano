# Copy to .env (the start scripts do this for you with random passwords). Never commit .env.
# Local development values only.

# Database
SCHOOMANO_DB_OWNER_USER=schoomano_owner
SCHOOMANO_DB_OWNER_PASSWORD=change-me-owner
SCHOOMANO_DB_APP_USER=schoomano_app
SCHOOMANO_DB_APP_PASSWORD=change-me-app

# Ports on 127.0.0.1. If one is taken by another program when you start, the scripts pick the
# next free port and save it here. (The backend's database URL is derived from SCHOOMANO_DB_PORT.)
SCHOOMANO_DB_PORT=5432
SCHOOMANO_API_PORT=8080
SCHOOMANO_WEB_PORT=8081
SCHOOMANO_DEV_WEB_PORT=5173

# LOCAL ONLY: synthetic-user sign-in ("Bearer dev:<subject>") in backend and web.
# The backend refuses to start with this and the 'prod' profile.
SCHOOMANO_AUTH_DEV_MODE=true

# Production sign-in (not used locally yet):
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://login.example.invalid/realms/schoomano
